{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "*.mjs",
      "*.json",
      "!**/public/vad",
      "!**/dist",
      "!**/src-tauri/target"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noConsole": "error"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/logger.ts", "scripts/**", "src/**/*.live.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/contract/**", "src/tauri-env.ts", "src/logger.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/config",
                      "**/config/**",
                      "**/renderer",
                      "**/renderer/**",
                      "**/settings",
                      "**/settings/**",
                      "**/io",
                      "**/io/**",
                      "**/dispatcher",
                      "**/dispatcher/**",
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/renderer",
                      "**/renderer/**",
                      "**/settings",
                      "**/settings/**",
                      "**/io",
                      "**/io/**",
                      "**/dispatcher",
                      "**/dispatcher/**",
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/settings",
                      "**/settings/**",
                      "**/io",
                      "**/io/**",
                      "**/dispatcher",
                      "**/dispatcher/**",
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/io/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/dispatcher",
                      "**/dispatcher/**",
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/settings/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/io",
                      "**/io/**",
                      "**/dispatcher",
                      "**/dispatcher/**",
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/dispatcher/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/ambient",
                      "**/ambient/**",
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ambient/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/ui",
                      "**/ui/**",
                      "**/app",
                      "**/app/**",
                      "**/windows",
                      "**/windows/**"
                    ],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app", "**/app/**", "**/windows", "**/windows/**"],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/windows", "**/windows/**"],
                    "message": "A layer imports only from the layers to its left (AGENTS.md, Engineering principles)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts", "src/**/*test-helpers*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
