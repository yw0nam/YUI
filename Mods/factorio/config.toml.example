# Path to Factorio's own config.ini. The Mod reads RCON host, port, and password
# from local-rcon-socket and local-rcon-password in that file. It never writes it.
config_ini = "~/Library/Application Support/factorio/config/config.ini"

# The YUI client's loopback signals ingress.
signals_url = "http://127.0.0.1:8770/signals"

[wake]
# Event kinds that notify the backend. Every other kind only enters the cache.
# These opt-in kinds stay cached and do not wake unless listed here: job_done,
# research_finished, attack_started, attack_ended, body_respawned, idle_changed,
# player_joined, player_left, snapshot_summary, body_threat (an enemy came within the body's safe radius),
# body_damaged (an enemy damaged the body).
kinds = [
  "chat",
  "queue_idle",
  "job_failed",
  "stopped",
  "body_died",
  "player_died",
  "rocket_launched",
]
# Quiet period after the first wake event before one doorbell is posted.
coalesce_ms = 2000

# JSONL record per polled event, doorbell post, and tool call. Relative to this file.
outcome_log = "outcome.jsonl"
