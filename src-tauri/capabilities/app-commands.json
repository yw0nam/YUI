{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-commands",
  "description": "every app command outside the MCP host, for every window",
  "windows": [
    "main",
    "pet-*",
    "settings",
    "settings-*",
    "message",
    "message-*",
    "quick-card",
    "quick-card-*",
    "unified",
    "devtools",
    "threads"
  ],
  "permissions": [
    "allow-drag-window",
    "allow-list-windows",
    "allow-list-screen-sources",
    "allow-capture-screen",
    "allow-capture-screen-at",
    "allow-import-vrm-file",
    "allow-remove-user-vrm",
    "allow-import-voice-file",
    "allow-remove-user-voice",
    "allow-rename-user-voice",
    "allow-import-card-file",
    "allow-retain-card-thumbnail",
    "allow-pick-preset-photo",
    "allow-remove-card-thumbnail",
    "allow-export-card-file",
    "allow-set-click-through",
    "allow-start-agent-ingress",
    "allow-sync-preset-ids",
    "allow-avatar-rpc-response",
    "allow-append-turn-record",
    "allow-set-frame-logical",
    "allow-threads-snapshot",
    "allow-thread-answer",
    "allow-window-dock-attach",
    "allow-window-dock-detach",
    "allow-terminal-snapshot",
    "allow-terminal-open",
    "allow-terminal-close",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-attach",
    "allow-terminal-answer",
    "allow-terminal-take-back",
    "allow-terminal-tool-open",
    "allow-terminal-tool-list",
    "allow-terminal-tool-read",
    "allow-terminal-tool-write",
    "allow-terminal-tool-close",
    "allow-terminal-tool-cancel"
  ]
}
