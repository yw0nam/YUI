{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "message",
  "description": "message window — a frameless always-on-top surface hosting the speech bubble and the text input; drags, resizes and repositions itself, creates no windows, and opens bubble links in the default browser",
  "windows": [
    "message"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
