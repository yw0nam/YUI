{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "threads",
  "description": "Threads window — a frameless always-on-top window beside the main character; places, shows, focuses and hides itself, and follows the stored theme",
  "windows": [
    "threads"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "log:default"
  ]
}
