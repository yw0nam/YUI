{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "threads",
  "description": "Threads window — a frameless window that opens beside the main character; places, drags and resizes itself, shows, focuses and hides itself, follows the stored theme, and opens entry links in the default browser",
  "windows": [
    "threads"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
