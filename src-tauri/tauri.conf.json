{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YUI",
  "version": "0.4.0",
  "identifier": "com.yui.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YUI",
        "width": 400,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws: wss: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**/*", "$APPDATA/vrms/**/*", "$APPDATA/references/**/*", "$APPDATA/stage/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "resources": {
      "../configs/": "configs/",
      "../resources/vrms/": "vrms/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
