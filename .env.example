# YUI dev 환경변수 예시. 복사해서 `.env.local`로 쓰고 실제 값 채운다(.env.local은 gitignore됨).

# Hermes chat API 키 (backend env API_SERVER_KEY와 동일 값). 키를 강제하는 백엔드는 없으면 401.
VITE_YUI_CHAT_KEY=

# STT 서버 키 (OpenAI 호환 Bearer). 키를 요구하는 STT 서버에만 필요.
VITE_YUI_STT_KEY=

# TTS 서버 키 (Bearer). 키를 요구하지 않는 서버라면 비워둔다.
VITE_YUI_TTS_KEY=

# 프론트 로그 레벨 (debug/info/warn/error). 미설정 시 dev=debug, release=warn.
VITE_YUI_LOG_LEVEL=

# 로그 타임스탬프 타임존. KST/JST/UTC/PST/EST 또는 오프셋(+09:00, +0900, 9). 미설정 시 UTC. (VITE_YUI_LOG_TZ도 인식됨)
YUI_LOG_TZ=KST
