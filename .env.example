# Example dev environment: copy to `.env.local` (gitignored) and fill in the values.

# API key for the chat backend; a backend that enforces a key returns 401 without it.
VITE_YUI_CHAT_KEY=

# API key for the STT server (OpenAI-compatible Bearer); needed only when the server requires a key.
VITE_YUI_STT_KEY=

# API key for any TTS provider (Bearer); leave empty when the server requires no key.
VITE_YUI_TTS_KEY=

# Frontend log level (debug, info, warn, error); unset means debug in dev and warn in release.
VITE_YUI_LOG_LEVEL=

# Log timestamp timezone: KST, JST, UTC, PST, EST, or an offset (+09:00, +0900, 9); unset means UTC, and VITE_YUI_LOG_TZ is also read.
YUI_LOG_TZ=
